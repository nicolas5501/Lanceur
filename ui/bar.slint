export struct BarItemData {
    id: string,
    name: string,
    target: string,
    icon_type: string,  // "emoji" ou "extracted"
    icon_emoji: string,
    icon_image: image,
    container_id: string,
    hotkey_display: string,
    bg_color: color,
    text_color: color,
}

export struct BarContainerData {
    flat_idx: int,
    id: string,
    name: string,
    icon: string,
    width_val: length, // 0 = auto
    display_mode: string, // "Both", "IconOnly", "NameOnly"
    bg_color: color,
    text_color: color,
    items: [BarItemData],
    hotkey_display: string,
}

export struct BarRowData {
    row_idx: int,
    containers: [BarContainerData],
}

export component DropdownItemRow inherits Rectangle {
    in property <string> item_name: "";
    in property <string> icon_type: "emoji";
    in property <string> icon_emoji: "🚀";
    in property <image> icon_image;
    in property <string> hotkey_display: "";
    in property <length> item_h: 26px;
    in property <length> font_sz: 11px;
    in property <color> custom_bg: #00000000;
    in property <color> custom_text: #ffffff;
    in property <color> hover_color: #2563eb;
    in property <string> hover_style: "Highlight";
    in property <bool> wave_cycle: false;
    callback clicked;

    property <color> eff_color: root.custom_bg.alpha > 0 ? root.custom_bg : root.hover_color;

    height: root.item_h;
    clip: true;

    // Fond et bordures dynamiques selon le style de survol sélectionné
    background: !itm_touch.has-hover ? #00000000 : (
        root.hover_style == "WaveBorder" ? eff_color.transparentize(0.85) :
        root.hover_style == "Blinking" ? (root.wave_cycle ? eff_color : eff_color.transparentize(0.70)) :
        root.hover_style == "Glow" ? eff_color.transparentize(0.75) :
        root.hover_style == "SlideAccent" ? eff_color.transparentize(0.85) :
        root.hover_style == "ScalePop" ? eff_color.transparentize(0.40) :
        root.hover_style == "GlassShimmer" ? eff_color.transparentize(0.55).brighter(0.2) :
        root.hover_style == "UnderlineWave" ? eff_color.transparentize(0.90) :
        eff_color
    );

    border-radius: (root.hover_style == "WaveBorder") ? 2px : 4px;
    border-width: !itm_touch.has-hover ? 0px : (
        root.hover_style == "WaveBorder" ? (root.wave_cycle ? 2px : 1px) :
        root.hover_style == "Glow" ? 1.5px :
        root.hover_style == "GlassShimmer" ? 1px : 0px
    );
    border-color: !itm_touch.has-hover ? #00000000 : (
        root.hover_style == "WaveBorder" ? (root.wave_cycle ? eff_color.brighter(0.4) : eff_color) :
        root.hover_style == "Glow" ? eff_color.brighter(0.5) :
        root.hover_style == "GlassShimmer" ? #ffffff55 : #00000000
    );

    drop-shadow-blur: !itm_touch.has-hover ? 0px : (
        root.hover_style == "Glow" ? 12px :
        root.hover_style == "WaveBorder" ? (root.wave_cycle ? 8px : 3px) :
        root.hover_style == "ScalePop" ? 6px : 0px
    );
    drop-shadow-color: root.hover_style == "ScalePop" ? #00000066 : eff_color;

    animate background { duration: (root.hover_style == "Blinking" ? 220ms : 80ms); }
    animate border-width { duration: 100ms; }
    animate border-color { duration: 100ms; }

    // Barre d'accentuation latérale (SlideAccent)
    if root.hover_style == "SlideAccent" : Rectangle {
        x: 0px;
        y: 2px;
        width: itm_touch.has-hover ? 4px : 0px;
        height: parent.height - 4px;
        background: eff_color.brighter(0.3);
        border-radius: 2px;
        animate width { duration: 120ms; easing: ease-out; }
    }

    // Barre de soulignement ondulant (UnderlineWave)
    if root.hover_style == "UnderlineWave" : Rectangle {
        x: itm_touch.has-hover ? (root.wave_cycle ? 4px : 12px) : 24px;
        y: parent.height - 2px;
        width: itm_touch.has-hover ? (root.wave_cycle ? parent.width - 8px : parent.width - 24px) : 0px;
        height: 2px;
        background: eff_color.brighter(0.3);
        border-radius: 1px;
        animate width { duration: 180ms; easing: ease-out; }
        animate x { duration: 180ms; easing: ease-out; }
    }

    content_holder := HorizontalLayout {
        x: (itm_touch.has-hover && root.hover_style == "ScalePop") ? 5px : 0px;
        padding-left: (root.hover_style == "SlideAccent" && itm_touch.has-hover) ? 12px : 8px;
        padding-right: 8px;
        spacing: 6px;
        alignment: center;
        animate x { duration: 100ms; easing: ease-out; }
        animate padding-left { duration: 120ms; easing: ease-out; }

        if root.icon_type == "extracted" : Image {
            source: root.icon_image;
            width: root.item_h * 0.7;
            height: root.item_h * 0.7;
            image-fit: contain;
            vertical-alignment: center;
        }

        if root.icon_type != "extracted" : Text {
            text: root.icon_emoji;
            font-size: root.font_sz + 2px;
            vertical-alignment: center;
        }

        Text {
            text: root.item_name;
            color: root.custom_text.alpha > 0 ? root.custom_text : (
                (itm_touch.has-hover && root.hover_style == "Glow") ? eff_color.brighter(0.7) : #ffffff
            );
            font-size: root.font_sz;
            font-weight: (itm_touch.has-hover && (root.hover_style == "Glow" || root.hover_style == "ScalePop")) ? 700 : 600;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }

        if root.hotkey_display != "" : Rectangle {
            background: itm_touch.has-hover ? eff_color.darker(0.2) : #334155;
            border-radius: 3px;
            height: 15px;
            HorizontalLayout {
                padding-left: 4px;
                padding-right: 4px;
                Text {
                    text: root.hotkey_display;
                    font-size: 9px;
                    color: itm_touch.has-hover ? #ffffff : #93c5fd;
                    font-weight: 700;
                    vertical-alignment: center;
                }
            }
        }
    }

    itm_touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component BarWindow inherits Window {
    title: "Lanceur Bandeau";
    background: #00000000;
    default-font-family: "Segoe UI, system-ui, sans-serif";
    no-frame: true;

    in property <string> bar_position: "Top";
    in property <string> containers_align: "Left"; // "Left", "Center", "Right"
    in property <color> bar_bg_color: #0f172a;
    in property <color> bar_text_color: #f8fafc;
    in property <color> dropdown_hover_color: #2563eb;
    in property <string> dropdown_hover_style: "Highlight";
    in-out property <bool> anim_pulse: false;
    in property <length> bar_h: 36px;
    in property <length> item_h: 26px;
    in property <length> container_font_sz: 11px;
    in property <length> item_font_sz: 11px;
    in property <[BarRowData]> rows_list: [];
    in property <int> rows_count: 1;
    in-out property <int> active_dropdown_idx: -1;

    callback launch_item(string);
    callback open_settings();
    callback open_context_menu();
    callback dropdown_state_changed(bool);
    callback container_width_changed(int, length);
    callback window_drag_started();
    callback window_dragged(length, length);
    callback window_width_changed(length);

    VerticalLayout {
        alignment: root.bar_position == "Bottom" ? end : start;

        main_bar := Rectangle {
            width: 100%;
            height: root.bar_h * max(1, root.rows_count);
            background: root.bar_bg_color;
            border-bottom-left-radius: (root.bar_position == "Top" || root.bar_position == "Floating") ? 6px : 0px;
            border-bottom-right-radius: (root.bar_position == "Top" || root.bar_position == "Floating") ? 6px : 0px;
            border-top-left-radius: (root.bar_position == "Bottom" || root.bar_position == "Floating") ? 6px : 0px;
            border-top-right-radius: (root.bar_position == "Bottom" || root.bar_position == "Floating") ? 6px : 0px;
            border-width: 1px;
            border-color: #334155aa;

            // TouchArea d'arrière-plan du bandeau : ferme le menu au survol et gère le clic droit / drag
            bar_bg_touch := TouchArea {
                pointer-event(event) => {
                    if event.kind == PointerEventKind.move {
                        if root.bar_position == "Floating" && self.pressed {
                            root.window_dragged(self.mouse-x - self.pressed-x, self.mouse-y - self.pressed-y);
                        }
                    } else if event.kind == PointerEventKind.down {
                        if root.bar_position == "Floating" {
                            root.window_drag_started();
                        } else if root.active_dropdown_idx >= 0 {
                            root.active_dropdown_idx = -1;
                            root.dropdown_state_changed(false);
                        }
                    } else if event.kind == PointerEventKind.up && event.button == PointerEventButton.right {
                        root.open_context_menu();
                    }
                }
            }

            rows_layout := VerticalLayout {
                padding: 0px;
                spacing: 0px;
                alignment: start;

                for row_data[r_idx] in root.rows_list : row_rect := Rectangle {
                    height: root.bar_h;
                    width: 100%;

                    HorizontalLayout {
                        padding-left: 6px;
                        padding-right: root.bar_position == "Floating" ? 14px : 6px;
                        spacing: 4px;
                        alignment: root.containers_align == "Center" ? center : (root.containers_align == "Right" ? end : start);

                        // Poignée de déplacement explicite en mode Flottant
                        if root.bar_position == "Floating" : Rectangle {
                            width: 18px;
                            height: parent.height;
                            Text {
                                text: "⠿";
                                font-size: 13px;
                                color: #64748b;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                            TouchArea {
                                mouse-cursor: move;
                                pointer-event(event) => {
                                    if event.kind == PointerEventKind.down {
                                        root.window_drag_started();
                                    } else if event.kind == PointerEventKind.move && self.pressed {
                                        root.window_dragged(self.mouse-x - self.pressed-x, self.mouse-y - self.pressed-y);
                                    }
                                }
                            }
                        }

                        // Liste Horizontale des Conteneurs de cette ligne (SANS dropdowns)
                        for cont[c_idx] in row_data.containers : cont_wrapper := Rectangle {
                            width: cont.width_val > 0px ? cont.width_val : cont_layout.min-width;
                            height: parent.height;
                            clip: false;

                            // Bouton Conteneur pleine hauteur avec couleurs personnalisables
                            cont_pill := Rectangle {
                                width: parent.width;
                                height: parent.height;
                                background: cont.bg_color.alpha > 0 ? (
                                    (root.active_dropdown_idx == cont.flat_idx || c_touch.has-hover) ? cont.bg_color.brighter(0.2) : cont.bg_color
                                ) : (
                                    (root.active_dropdown_idx == cont.flat_idx || c_touch.has-hover) ? #334155 : #1e293b00
                                );
                                border-radius: 4px;
                                border-width: 1px;
                                border-color: (root.active_dropdown_idx == cont.flat_idx || c_touch.has-hover) ? #60a5fa : #00000000;
                                animate background { duration: 80ms; }

                                cont_layout := HorizontalLayout {
                                    padding-left: 10px;
                                    padding-right: 10px;
                                    spacing: 6px;
                                    alignment: center;

                                    if cont.display_mode != "NameOnly" : Text {
                                        text: cont.icon;
                                        font-size: root.container_font_sz + 2px;
                                        vertical-alignment: center;
                                    }

                                    if cont.display_mode != "IconOnly" : Text {
                                        text: cont.name;
                                        font-size: root.container_font_sz;
                                        font-weight: 700;
                                        color: cont.text_color.alpha > 0 ? cont.text_color : root.bar_text_color;
                                        vertical-alignment: center;
                                    }

                                    Text {
                                        text: root.bar_position == "Bottom" ? "▴" : "▾";
                                        font-size: 8px;
                                        color: cont.text_color.alpha > 0 ? cont.text_color.darker(0.3) : #94a3b8;
                                        vertical-alignment: center;
                                    }
                                }

                                // TouchArea pour ouvrir le menu au survol ou le menu contextuel au clic droit
                                c_touch := TouchArea {
                                    mouse-cursor: pointer;
                                    pointer-event(event) => {
                                        if event.kind == PointerEventKind.move && self.has-hover {
                                            // N'ouvre/change le dropdown que si c'est le sien ou s'il n'y en a pas d'actif
                                            if root.active_dropdown_idx == -1 || root.active_dropdown_idx == cont.flat_idx {
                                                if root.active_dropdown_idx != cont.flat_idx {
                                                    root.active_dropdown_idx = cont.flat_idx;
                                                    root.dropdown_state_changed(true);
                                                }
                                            }
                                        } else if event.kind == PointerEventKind.up && event.button == PointerEventButton.right {
                                            root.open_context_menu();
                                        }
                                    }
                                }

                                // Poignée de redimensionnement discrète
                                resize_handle := Rectangle {
                                    x: parent.width - 5px;
                                    width: 5px;
                                    height: parent.height;
                                    background: #00000000;
                                    TouchArea {
                                        mouse-cursor: col-resize;
                                        moved => {
                                            let new_w = max(36px, cont_pill.width + (self.mouse-x - self.pressed-x));
                                            root.container_width_changed(cont.flat_idx, new_w);
                                        }
                                    }
                                }
                            }

                            // Le Menu Déroulant rattaché DIRECTEMENT
                            if root.active_dropdown_idx == cont.flat_idx : dropdown_popover := Rectangle {
                                x: 0px;
                                height: max(32px, (cont.items.length * (root.item_h + 2px)) + 8px);
                                y: root.bar_position == "Bottom" ? -self.height : parent.height;
                                width: max(cont_pill.width, max(190px, dropdown_layout.min-width + 16px));
                                background: root.bar_bg_color.with-alpha(1.0);
                                border-radius: 4px;
                                border-width: 1px;
                                border-color: #3b82f6cc;
                                drop-shadow-blur: 10px;
                                drop-shadow-color: #000000aa;

                                dropdown_layout := VerticalLayout {
                                    padding: 4px;
                                    spacing: 2px;

                                    if cont.items.length == 0 : Rectangle {
                                        height: 26px;
                                        Text { text: "Aucun item."; color: #64748b; font-size: 10px; horizontal-alignment: center; vertical-alignment: center; }
                                    }

                                    for itm in cont.items : DropdownItemRow {
                                        item_name: itm.name;
                                        icon_type: itm.icon_type;
                                        icon_emoji: itm.icon_emoji;
                                        icon_image: itm.icon_image;
                                        hotkey_display: itm.hotkey_display;
                                        item_h: root.item_h;
                                        font_sz: root.item_font_sz;
                                        custom_bg: itm.bg_color;
                                        custom_text: itm.text_color;
                                        hover_color: root.dropdown_hover_color;
                                        hover_style: root.dropdown_hover_style;
                                        wave_cycle: root.anim_pulse;
                                        clicked => {
                                            root.active_dropdown_idx = -1;
                                            root.dropdown_state_changed(false);
                                            root.launch_item(itm.target);
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // Poignée de redimensionnement de la largeur du bandeau en mode Flottant
            if root.bar_position == "Floating" : Rectangle {
                x: parent.width - 8px;
                width: 8px;
                height: parent.height;
                background: #00000000;
                TouchArea {
                    mouse-cursor: ew-resize;
                    moved => {
                        let new_w = max(260px, main_bar.width + (self.mouse-x - self.pressed-x));
                        root.window_width_changed(new_w);
                    }
                }
            }
        }
    }
}
