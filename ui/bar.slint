export struct BarItemData {
    id: string,
    name: string,
    target: string,
    icon_type: string,  // "emoji" ou "extracted"
    icon_emoji: string,
    icon_image: image,
    container_id: string,
    hotkey_display: string,
    bg_color: color,
    text_color: color,
}

export struct BarContainerData {
    id: string,
    name: string,
    icon: string,
    width_val: length, // 0 = auto
    display_mode: string, // "Both", "IconOnly", "NameOnly"
    bg_color: color,
    text_color: color,
    items: [BarItemData],
    hotkey_display: string,
}

component DropdownItemRow inherits Rectangle {
    in property <string> item_name: "";
    in property <string> icon_type: "emoji";
    in property <string> icon_emoji: "🚀";
    in property <image> icon_image;
    in property <string> hotkey_display: "";
    in property <length> item_h: 26px;
    in property <length> font_sz: 11px;
    in property <color> custom_bg: #00000000;
    in property <color> custom_text: #ffffff;
    callback clicked;

    height: root.item_h;
    background: itm_touch.has-hover ? (root.custom_bg.alpha > 0 ? root.custom_bg : #2563eb) : #00000000;
    border-radius: 4px;
    animate background { duration: 60ms; }

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 6px;
        alignment: center;

        if root.icon_type == "extracted" : Image {
            source: root.icon_image;
            width: root.item_h * 0.7;
            height: root.item_h * 0.7;
            image-fit: contain;
            vertical-alignment: center;
        }

        if root.icon_type != "extracted" : Text {
            text: root.icon_emoji;
            font-size: root.font_sz + 2px;
            vertical-alignment: center;
        }

        Text {
            text: root.item_name;
            color: root.custom_text.alpha > 0 ? root.custom_text : #ffffff;
            font-size: root.font_sz;
            font-weight: 600;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }

        if root.hotkey_display != "" : Rectangle {
            background: itm_touch.has-hover ? #1d4ed8 : #334155;
            border-radius: 3px;
            height: 15px;
            HorizontalLayout {
                padding-left: 4px;
                padding-right: 4px;
                Text {
                    text: root.hotkey_display;
                    font-size: 9px;
                    color: #93c5fd;
                    font-weight: 700;
                    vertical-alignment: center;
                }
            }
        }
    }

    itm_touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component BarWindow inherits Window {
    title: "Lanceur Bandeau";
    background: #00000000;
    default-font-family: "Segoe UI, system-ui, sans-serif";
    no-frame: true;

    in property <string> bar_position: "Top";
    in property <string> containers_align: "Left"; // "Left", "Center", "Right"
    in property <color> bar_bg_color: #0f172a;
    in property <color> bar_text_color: #f8fafc;
    in property <length> bar_h: 36px;
    in property <length> item_h: 26px;
    in property <length> container_font_sz: 11px;
    in property <length> item_font_sz: 11px;
    in property <[BarContainerData]> containers_list: [];
    in-out property <int> active_dropdown_idx: -1;

    callback launch_item(string);
    callback open_settings();
    callback open_context_menu();
    callback dropdown_state_changed(bool);
    callback container_width_changed(int, length);

    VerticalLayout {
        alignment: root.bar_position == "Bottom" ? end : start;

        main_bar := Rectangle {
            width: 100%;
            height: root.bar_h;
            background: root.bar_bg_color;
            border-bottom-left-radius: root.bar_position == "Top" ? 6px : 0px;
            border-bottom-right-radius: root.bar_position == "Top" ? 6px : 0px;
            border-top-left-radius: root.bar_position == "Bottom" ? 6px : 0px;
            border-top-right-radius: root.bar_position == "Bottom" ? 6px : 0px;
            border-width: 1px;
            border-color: #334155aa;

            // TouchArea d'arrière-plan du bandeau : ferme le menu au survol et gère le clic droit
            bar_bg_touch := TouchArea {
                pointer-event(event) => {
                    if event.kind == PointerEventKind.move {
                        if root.active_dropdown_idx >= 0 {
                            root.active_dropdown_idx = -1;
                            root.dropdown_state_changed(false);
                        }
                    } else if event.kind == PointerEventKind.up && event.button == PointerEventButton.right {
                        root.open_context_menu();
                    }
                }
            }

            HorizontalLayout {
                padding-left: 6px;
                padding-right: 6px;
                spacing: 4px;
                alignment: root.containers_align == "Center" ? center : (root.containers_align == "Right" ? end : start);

                // Liste Horizontale des Conteneurs
                for cont[idx] in root.containers_list : cont_wrapper := Rectangle {
                    width: cont.width_val > 0px ? cont.width_val : cont_layout.min-width;
                    height: parent.height;

                    // Bouton Conteneur pleine hauteur avec couleurs personnalisables
                    cont_pill := Rectangle {
                        width: parent.width;
                        height: parent.height;
                        background: cont.bg_color.alpha > 0 ? (
                            (root.active_dropdown_idx == idx || c_touch.has-hover) ? cont.bg_color.brighter(0.2) : cont.bg_color
                        ) : (
                            (root.active_dropdown_idx == idx || c_touch.has-hover) ? #334155 : #1e293b00
                        );
                        border-radius: 4px;
                        border-width: 1px;
                        border-color: (root.active_dropdown_idx == idx || c_touch.has-hover) ? #60a5fa : #00000000;
                        animate background { duration: 80ms; }

                        cont_layout := HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            spacing: 6px;
                            alignment: center;

                            if cont.display_mode != "NameOnly" : Text {
                                text: cont.icon;
                                font-size: root.container_font_sz + 2px;
                                vertical-alignment: center;
                            }

                            if cont.display_mode != "IconOnly" : Text {
                                text: cont.name;
                                font-size: root.container_font_sz;
                                font-weight: 700;
                                color: cont.text_color.alpha > 0 ? cont.text_color : root.bar_text_color;
                                vertical-alignment: center;
                            }

                            Text {
                                text: root.bar_position == "Bottom" ? "▴" : "▾";
                                font-size: 8px;
                                color: cont.text_color.alpha > 0 ? cont.text_color.darker(0.3) : #94a3b8;
                                vertical-alignment: center;
                            }
                        }

                        // TouchArea pour ouvrir le menu au survol ou le menu contextuel au clic droit
                        c_touch := TouchArea {
                            mouse-cursor: pointer;
                            pointer-event(event) => {
                                if event.kind == PointerEventKind.move || self.has-hover {
                                    if root.active_dropdown_idx != idx {
                                        root.active_dropdown_idx = idx;
                                        root.dropdown_state_changed(true);
                                    }
                                } else if event.kind == PointerEventKind.up && event.button == PointerEventButton.right {
                                    root.open_context_menu();
                                }
                            }
                        }

                        // Poignée de redimensionnement discrète
                        resize_handle := Rectangle {
                            x: parent.width - 5px;
                            width: 5px;
                            height: parent.height;
                            background: #00000000;
                            TouchArea {
                                mouse-cursor: col-resize;
                                moved => {
                                    let new_w = max(36px, cont_pill.width + (self.mouse-x - self.pressed-x));
                                    root.container_width_changed(idx, new_w);
                                }
                            }
                        }
                    }

                    // Le Menu Déroulant rattaché DIRECTEMENT avec personnalisation des couleurs
                    if root.active_dropdown_idx == idx : dropdown_popover := Rectangle {
                        x: 0px;
                        height: max(32px, (cont.items.length * (root.item_h + 2px)) + 8px);
                        y: root.bar_position == "Bottom" ? -self.height : parent.height;
                        width: max(cont_pill.width, max(190px, dropdown_layout.min-width + 16px));
                        background: root.bar_bg_color;
                        border-radius: 4px;
                        border-width: 1px;
                        border-color: #3b82f6cc;
                        drop-shadow-blur: 10px;
                        drop-shadow-color: #000000aa;

                        dropdown_layout := VerticalLayout {
                            padding: 4px;
                            spacing: 2px;

                            if cont.items.length == 0 : Rectangle {
                                height: 26px;
                                Text { text: "Aucun item."; color: #64748b; font-size: 10px; horizontal-alignment: center; vertical-alignment: center; }
                            }

                            for itm in cont.items : DropdownItemRow {
                                item_name: itm.name;
                                icon_type: itm.icon_type;
                                icon_emoji: itm.icon_emoji;
                                icon_image: itm.icon_image;
                                hotkey_display: itm.hotkey_display;
                                item_h: root.item_h;
                                font_sz: root.item_font_sz;
                                custom_bg: itm.bg_color;
                                custom_text: itm.text_color;
                                clicked => {
                                    root.active_dropdown_idx = -1;
                                    root.dropdown_state_changed(false);
                                    root.launch_item(itm.target);
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
